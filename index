<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Plataforma de Streaming</title>
    <!-- Estilos de Plyr -->
    <link rel="stylesheet" href="https://plyr.io" />
    <style>
        body {
            background-color: #0f0f14;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            margin: 0;
            min-height: 100vh;
        }
        h1 { margin-bottom: 20px; font-size: 24px; color: #e50914; } /* Rojo estilo Netflix */
        
        /* Contenedor principal para video + lista */
        .dashboard {
            display: flex;
            width: 100%;
            max-width: 1100px;
            gap: 20px;
            background: #18181f;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }
        .contenedor-video {
            flex: 2;
            border-radius: 8px;
            overflow: hidden;
            background: #000;
        }
        /* Menú lateral de canales/películas */
        .playlist {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-height: 450px;
            overflow-y: auto;
        }
        .canal-btn {
            background: #262631;
            color: white;
            border: none;
            padding: 15px;
            text-align: left;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            transition: background 0.2s ease;
        }
        .canal-btn:hover { background: #3e3e52; }
        .canal-btn.activo { background: #e50914; font-weight: bold; }

        @media (max-width: 768px) {
            .dashboard { flex-direction: column; }
        }
    </style>
</head>
<body>

    <h1>🎬 Mi Plataforma de Streaming Interactiva</h1>

    <div class="dashboard">
        <!-- El Reproductor -->
        <div class="contenedor-video">
            <video controls crossorigin playsinline></video>
        </div>

        <!-- El Menú de Opciones -->
        <div class="playlist" id="lista-canales">
            <!-- Los botones se generarán automáticamente con JavaScript -->
        </div>
    </div>

    <!-- Librerías de Video -->
    <script src="https://jsdelivr.net"></script>
    <script src="https://plyr.io"></script>

    <script>
        // 1. Definimos nuestro catálogo de videos (.m3u8 públicos)
        const catalogo = [
            {
                titulo: "🎥 Película: Sintel (Animación)",
                url: "https://akamaihd.net"
            },
            {
                titulo: "🐰 Película: Big Buck Bunny",
                url: "https://mux.dev"
            },
            {
                titulo: "🚀 Stream de Prueba: Tears of Steel",
                url: "https://unified-streaming.com"
            }
        ];

        let hls;
        const video = document.querySelector('video');
        const listaCanales = document.getElementById('lista-canales');

        // 2. Función clave para cambiar la película en el reproductor
        function cargarVideo(url) {
            // Si ya había un video cargándose, lo destruimos para liberar memoria
            if (hls) {
                hls.destroy();
            }

            if (Hls.isSupported()) {
                hls = new Hls();
                hls.loadSource(url);
                hls.attachMedia(video);
                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    video.play().catch(e => console.log("Auto-play bloqueado por el navegador, requiere clic."));
                });
            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = url;
            }
        }

        // 3. Generar los botones del menú dinámicamente
        catalogo.forEach((item, index) => {
            const boton = document.createElement('button');
            boton.className = 'canal-btn';
            boton.innerText = item.titulo;
            
            // Si es el primer elemento, lo marcamos como activo por defecto
            if (index === 0) boton.classList.add('activo');

            boton.addEventListener('click', () => {
                // Quitar clase activo a todos los botones
                document.querySelectorAll('.canal-btn').forEach(btn => btn.classList.remove('activo'));
                // Poner activa la opción seleccionada
                boton.classList.add('activo');
                // Cargar el nuevo video
                cargarVideo(item.url);
            });

            listaCanales.appendChild(boton);
        });

        // 4. Inicializar Plyr para el diseño premium
        const player = new Plyr(video);

        // 5. Cargar el primer video automáticamente al abrir la página
        cargarVideo(catalogo[0].url);
    </script>
</body>
</html>
